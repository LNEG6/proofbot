# Copy this file to .env and fill it in. Never share .env.

# The only folder the agent may change. Keep it separate from this proofbot folder.
WORKSPACE=C:\Users\you\Documents\my-project

# Your project's tests. The harness runs them before and after every job. Optional but recommended.
TEST_COMMAND=python -m pytest -q

# Which AI does the work and reads your requests: claude (Claude Code) or codex.
# Left empty, Claude Code is used if it's installed. Either one must be signed in.
AGENT=

# on (default): before any work, readers go through what your request could mean, and any real difference
# becomes a question for you. off: skip it (reports then say nothing looked for other meanings).
READINGS=on

# on (default): before any work, a second AI shown only your request and the sealed checks says whether
# they test what you asked. A missing or misread part makes the job UNPROVEN. off: skip it (reports then warn).
REVIEW=on

# Leave empty to choose by agent. sandbox: checks and tests run in the Codex sandbox, confined to the workspace
# (Codex only). direct: they run as you, unsandboxed.
CHECK_RUNNER=

# Only for the WhatsApp front end. See docs/whatsapp.md.
WHATSAPP_TOKEN=
PHONE_NUMBER_ID=
APP_SECRET=
VERIFY_TOKEN=
OWNER_NUMBER=
PORT=8787
