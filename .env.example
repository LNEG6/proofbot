# Copy this file to .env and fill it in. Never share .env: it holds your WhatsApp token.

# The only folder Codex may change. Keep it separate from this proofbot folder.
WORKSPACE=C:\Users\you\Documents\my-project

# Your project's tests. The harness runs them before and after every job. Optional but recommended.
TEST_COMMAND=python -m pytest -q

# sandbox (default): checks and tests run in the Codex sandbox, confined to the workspace.
# direct: they run as you, unsandboxed. See "Let the sandbox run Python" in README.md first.
CHECK_RUNNER=sandbox

# on (default): before any work, a second AI shown only your request and the sealed checks says whether
# they test what you asked. A missing or misread part makes the job UNPROVEN. off: skip it (reports then warn).
REVIEW=on

# Meta developer app > WhatsApp > API Setup
WHATSAPP_TOKEN=
PHONE_NUMBER_ID=

# Meta developer app > App settings > Basic > App secret
APP_SECRET=

# Any phrase you make up. Paste the same phrase into Meta's webhook settings.
VERIFY_TOKEN=

# Your own WhatsApp number with country code. Only this number can give orders.
OWNER_NUMBER=+65 9123 4567

PORT=8787
